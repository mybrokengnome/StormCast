# ---- Email intake (photos arrive as attachments) ----------------------------
# Leave EMAIL_USER / EMAIL_PASSWORD blank to disable email intake.
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993

# Only accept photos from these senders (comma separated), and only when the
# subject line contains REQUIRED_SUBJECT (case-insensitive).
ALLOWED_EMAILS=
REQUIRED_SUBJECT=slideshow

# How often to poll the inbox, in milliseconds (minimum 10000).
EMAIL_CHECK_INTERVAL=30000

# ---- Weather (OpenWeatherMap, free tier) ------------------------------------
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
LATITUDE=27.9517
LONGITUDE=-82.4588
# imperial (°F, mph, inHg) or metric (°C, km/h, hPa)
WEATHER_UNITS=imperial
WEATHER_UPDATE_INTERVAL=600000

# ---- Radar (NOAA / NWS RIDGE) -----------------------------------------------
# Your nearest NEXRAD site, e.g. KTBW (Tampa Bay). Find yours at
# https://radar.weather.gov
NOAA_LOCATION=KTBW
RADAR_UPDATE_INTERVAL=300000

# ---- Weather alerts (National Weather Service, US only, no key needed) ------
# Active watches and warnings for LATITUDE/LONGITUDE are shown on the frame.
WEATHER_ALERTS=true
ALERT_UPDATE_INTERVAL=180000

# ---- Display ----------------------------------------------------------------
PORT=3000
IMAGE_DIRECTORY=./uploads/images
# Keep at most this many photos; the oldest are deleted as new ones arrive.
MAX_IMAGES=200
# Seconds each photo is shown, in milliseconds.
SLIDESHOW_INTERVAL=10000
# Show the radar loop after every N photos (0 disables radar in the rotation).
RADAR_EVERY=5
# Photo order: smart (random, recent photos appear more often), shuffle, or newest.
SLIDESHOW_ORDER=smart
