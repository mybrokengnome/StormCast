{
  "name": "stormcast",
  "version": "2.0.0",
  "description": "StormCast: a Raspberry Pi photo frame with live weather and NOAA radar",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "setup": "mkdir -p uploads/images && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.0.188",
    "mailparser": "^3.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
